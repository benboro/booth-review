# This is a public repo. Anything not deliberately published stays local.

# ── Secrets ─────────────────────────────────────────────────────────────────
.env
.env.*
!.env.example
.envrc
*.pem
*.key

# ── Data ────────────────────────────────────────────────────────────────────
# Deny by default. Scraped pages and API responses belong to their sources and
# are not ours to redistribute; see data/README.md. data/vault/ is a clone of
# the private data repo (raw/, interim/, processed/, ledger/, spike/) and
# stays ignored under data/* like everything else here.
data/*
!data/README.md
!data/reference/
# Publish chain for cleared processed tables (this repo only, never the
# vault): un-ignore the directory, then re-deny its files by default, so a
# single `!data/processed/<file>` line below is the only thing that publishes
# a table, once data/README.md's source terms allow it.
!data/processed/
data/processed/*
# !data/processed/<file>

# HTTP and query caches can hold full responses (and request headers, including
# API keys), so they're ignored wherever they land.
.cache/
*.sqlite
*.sqlite3
*.db
*.duckdb

# ── Python ──────────────────────────────────────────────────────────────────
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info
.venv

# ── Tool caches ─────────────────────────────────────────────────────────────
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.ipynb_checkpoints/

# ── Local planning ──────────────────────────────────────────────────────────
# GSD planning files and Fable task briefs stay on this machine.
.planning/
fable-*.md

# ── Local editor and agent settings ─────────────────────────────────────────
.claude/
.vscode/
.idea/
.DS_Store
Thumbs.db
