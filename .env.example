# Copy to .env and fill in. .env is gitignored; never commit a real key.

# CollegeFootballData.com API key (free): https://collegefootballdata.com/key
CFBD_API_KEY=

# Missing-crew and hand-save reminder email (booth-review job crew-alerts). The scheduled job reads
# these from the data repo's Actions secrets; set them here only to send from a
# local run. For Gmail, use smtp.gmail.com, port 587 and an app password
# (https://myaccount.google.com/apppasswords), never the account password.
BOOTH_REVIEW_SMTP_HOST=
BOOTH_REVIEW_SMTP_PORT=587
BOOTH_REVIEW_SMTP_USER=
BOOTH_REVIEW_SMTP_PASSWORD=
# Comma-separated recipients.
BOOTH_REVIEW_ALERT_TO=
# Optional From address; defaults to BOOTH_REVIEW_SMTP_USER.
BOOTH_REVIEW_ALERT_FROM=
